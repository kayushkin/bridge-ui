{
  "name": "@kayushkin/bridge-ui",
  "version": "0.4.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "styles.css",
    "theme.css"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "vite --config standalone/vite.config.ts",
    "build:standalone": "vite build --config standalone/vite.config.ts",
    "check": "esbuild scripts/render-check.mjs --bundle --platform=node --format=cjs --outfile=node_modules/.cache/bridge-ui-render-check.cjs --log-level=error && node node_modules/.cache/bridge-ui-render-check.cjs"
  },
  "dependencies": {
    "@kayushkin/llm-bridge-types": "file:../llm-bridge/ts",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^7.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/mdast": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "typescript": "~5.9.3",
    "vite": "^6.0.7"
  }
}
